ISO-10303-21;
HEADER;
/* A 2D CSG primitive solid in inches, the inch given by a plain MEASURE_WITH_UNIT. */
FILE_DESCRIPTION(('2D primitive in inches'),'2;1');
FILE_NAME('primitive_2d_inch.stp','2026-10-27T00:00:00',(''),(''),'','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF'));
ENDSEC;
DATA;
#1=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#2=MEASURE_WITH_UNIT(LENGTH_MEASURE(25.4),#1);
#3=DIMENSIONAL_EXPONENTS(1.,0.,0.,0.,0.,0.,0.);
#4=(CONVERSION_BASED_UNIT('INCH',#2)LENGTH_UNIT()NAMED_UNIT(#3));
#5=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#6=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#7=(GEOMETRIC_REPRESENTATION_CONTEXT(2)GLOBAL_UNIT_ASSIGNED_CONTEXT((#4,#5,#6))REPRESENTATION_CONTEXT('2D','inch'));
#10=CARTESIAN_POINT('',(1.,1.));
#11=CIRCULAR_AREA('disc',#10,0.5);
#12=CSG_PRIMITIVE_SOLID_2D('disc',#11);
#13=CSG_2D_SHAPE_REPRESENTATION('disc',(#12),#7);
ENDSEC;
END-ISO-10303-21;
