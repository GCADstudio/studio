# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Wavefront OBJ is a GCAD export format; keep reference files under tests/
!tests/**/*.obj

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local export output
/out/

# The built web studio and its download cache (tools/build_site.py)
/site/
/.cache/

# Front-end vendoring tool (its output in src/gcad/web/vendor is committed)
/tools/vendor-web/node_modules/
