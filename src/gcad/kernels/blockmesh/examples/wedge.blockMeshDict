/*--------------------------------*- C++ -*----------------------------------*\
  A 5 degree wedge of an axisymmetric pipe that narrows to a nozzle, along x.
  Each block collapses two vertices onto the axis, so it is a prism; this is
  how blockMesh builds axisymmetric (wedge) cases. Coordinates in metres.
  Written for GCAD Studio's blockmesh kernel; any OpenFOAM blockMesh reads it.
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// radius 20 mm, then 10 mm; +-2.5 degrees about the x axis
vertices
(
    (0     0                   0)                     // 0  on the axis
    (0.1   0                   0)                     // 1  on the axis
    (0.1   0.0199809644316372  0.00087238774730672)   // 2
    (0     0.0199809644316372  0.00087238774730672)   // 3
    (0     0.0199809644316372 -0.00087238774730672)   // 4
    (0.1   0.0199809644316372 -0.00087238774730672)   // 5
    (0.15  0                   0)                     // 6  on the axis
    (0.15  0.00999048221581858 0.00043619387365336)   // 7
    (0.15  0.00999048221581858 -0.00043619387365336)  // 8
);

blocks
(
    hex (0 1 5 4 0 1 2 3) pipe   (40 10 1) simpleGrading (1 1 1)
    hex (1 6 8 5 1 6 7 2) nozzle (20 10 1) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    front
    {
        type wedge;
        faces ((0 3 2 1) (1 2 7 6));
    }
    back
    {
        type wedge;
        faces ((0 1 5 4) (1 6 8 5));
    }
    wall
    {
        type wall;
        faces ((4 5 2 3) (5 8 7 2));
    }
);
