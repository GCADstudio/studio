ISO-10303-21;
HEADER;
/* 2D CSG as AP242 carries it (CSG_SOLID_2D of BOOLEAN_RESULT_2D), written by hand: a plate
   with a round hole, a square cut-out and an elliptic boss. */
FILE_DESCRIPTION(('2D CSG plate'),'2;1');
FILE_NAME('csg_2d.stp','2026-10-27T00:00:00',(''),(''),'','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF'));
ENDSEC;
DATA;
#1=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#2=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#3=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#4=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#1,'distance_accuracy_value','confusion accuracy');
#5=(GEOMETRIC_REPRESENTATION_CONTEXT(2)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#4))GLOBAL_UNIT_ASSIGNED_CONTEXT((#1,#2,#3))REPRESENTATION_CONTEXT('2D',''));
#6=APPLICATION_CONTEXT('managed model based 3d engineering');
#7=APPLICATION_PROTOCOL_DEFINITION('international standard','ap242_managed_model_based_3d_engineering_mim_lf',2020,#6);
#8=PRODUCT_CONTEXT('',#6,'mechanical');
#10=DIRECTION('',(1.,0.));
#11=CARTESIAN_POINT('',(0.,0.));
#12=AXIS2_PLACEMENT_2D('',#11,#10);
#13=RECTANGULAR_AREA('plate',#12,60.,40.);
#14=CARTESIAN_POINT('',(15.,20.));
#15=CIRCULAR_AREA('hole',#14,6.);
#16=CARTESIAN_POINT('',(35.,10.));
#17=CARTESIAN_POINT('',(45.,10.));
#18=CARTESIAN_POINT('',(45.,20.));
#19=CARTESIAN_POINT('',(35.,20.));
#20=POLYGONAL_AREA('cut-out',(#16,#17,#18,#19));
#21=CARTESIAN_POINT('',(50.,32.));
#22=AXIS2_PLACEMENT_2D('',#21,#10);
#23=ELLIPTIC_AREA('boss',#22,8.,4.);
#24=BOOLEAN_RESULT_2D('',.DIFFERENCE.,#13,#15);
#25=BOOLEAN_RESULT_2D('',.DIFFERENCE.,#24,#20);
#26=BOOLEAN_RESULT_2D('',.UNION.,#25,#23);
#27=CSG_SOLID_2D('plate',#26);
#28=CSG_2D_SHAPE_REPRESENTATION('plate',(#27),#5);
ENDSEC;
END-ISO-10303-21;
