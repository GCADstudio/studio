ISO-10303-21;
HEADER;
/* Lengths in inches (a conversion-based unit) and angles in degrees, written by hand:
   a 2 x 1 x 0.5 inch block with a cone whose semi-angle is 15 degrees. */
FILE_DESCRIPTION(('inch and degree units'),'2;1');
FILE_NAME('units_inch.stp','2026-10-27T00:00:00',(''),(''),'','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF'));
ENDSEC;
DATA;
#1=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#2=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(25.4),#1);
#3=DIMENSIONAL_EXPONENTS(1.,0.,0.,0.,0.,0.,0.);
#4=(CONVERSION_BASED_UNIT('INCH',#2)LENGTH_UNIT()NAMED_UNIT(#3));
#5=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#6=PLANE_ANGLE_MEASURE_WITH_UNIT(PLANE_ANGLE_MEASURE(0.017453292519943295),#5);
#7=DIMENSIONAL_EXPONENTS(0.,0.,0.,0.,0.,0.,0.);
#8=(CONVERSION_BASED_UNIT('DEGREE',#6)NAMED_UNIT(#7)PLANE_ANGLE_UNIT());
#9=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#10=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-05),#4,'distance_accuracy_value','confusion accuracy');
#11=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#10))GLOBAL_UNIT_ASSIGNED_CONTEXT((#4,#8,#9))REPRESENTATION_CONTEXT('3D','inch'));
#12=APPLICATION_CONTEXT('managed model based 3d engineering');
#13=APPLICATION_PROTOCOL_DEFINITION('international standard','ap242_managed_model_based_3d_engineering_mim_lf',2020,#12);
#14=PRODUCT_CONTEXT('',#12,'mechanical');
#20=DIRECTION('',(0.,0.,1.));
#21=DIRECTION('',(1.,0.,0.));
#22=CARTESIAN_POINT('',(0.,0.,0.));
#23=AXIS2_PLACEMENT_3D('',#22,#20,#21);
#24=BLOCK('block',#23,2.,1.,0.5);
#25=CARTESIAN_POINT('',(1.,0.5,1.5));
#26=AXIS1_PLACEMENT('',#25,#20);
#27=RIGHT_CIRCULAR_CONE('cone',#26,1.,0.,15.);
#28=BOOLEAN_RESULT('',.UNION.,#24,#27);
#29=CSG_SOLID('',#28);
#30=CSG_SHAPE_REPRESENTATION('inch',(#29),#11);
ENDSEC;
END-ISO-10303-21;
