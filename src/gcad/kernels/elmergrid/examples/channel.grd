***** A cooling channel between two walls, sized with MATC *****
! Change w, t or l and the geometry follows. MATC reads "0 t t+w" as [0 t t] + w, because
! space-separated values form a row before any operator applies, so sums, products and
! quotients are put in parentheses.
! ElmerGrid reads at most four numbers from one MATC result.
Version = 210903
MATC = True
$ w = 4          ! channel width
$ t = 1.5        ! wall thickness
$ l = 30         ! length
Coordinate System = Cartesian 2D
Subcell Divisions in 2D = 3 2
Subcell Limits 1 = $ 0 t (t+w) (2*t+w)
Subcell Limits 2 = $ 0 (l/3) l
Material Structure in 2D
  1  2  1
  1  3  1
End
Materials Interval = 1 3
Boundary Definitions
! type     out      int
  1        -1        1        1
  2        -3        2        1
End
Element Degree = 1
Element Innernodes = False
Triangles = False
Element Divisions 1 = $ 3 8 3
Element Divisions 2 = 20 40
