***** A die in a substrate cavity under a lid ring, as three extruded layers *****
! Each Extruded Structure row is one layer in z: the 2D materials first..last are kept and
! renumbered to new (0 keeps their number). Bulk Type Mappings renumbers the result.
Version = 210903
Coordinate System = Cartesian 3D
Subcell Divisions in 3D = 3 3 3
Subcell Limits 1 = 0 3 9 12
Subcell Limits 2 = 0 2 8 10
Subcell Limits 3 = 0 1 1.5 3
Material Structure in 2D
  1  1  1
  1  2  1
  1  1  1
End
Materials Interval = 1 2
Extruded Structure
! first   last   new
  1       2      1
  1       2      0
  1       1      4
End
Bulk Type Mappings
! first   last   new
  4       4      3
End
Boundary Definitions
! type     out      int
  1         0        1        1
End
Element Degree = 1
Element Innernodes = False
Triangles = False
Element Divisions 1 = 3 6 3
Element Divisions 2 = 2 6 2
Element Divisions 3 = 2 1 3
